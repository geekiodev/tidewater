# Copy to .env.local and fill in values. Never commit .env.local or any real key.
# Every value below is a dummy placeholder.

# Public URL of the app (used for redirects and the CSRF origin check)
APP_URL=http://localhost:3000

# Supabase (from `npx supabase start` / `npx supabase status` for local dev)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon-key-replace-with-local-value
# Server only. Used for rate limiting and Stripe webhook writes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key-replace-with-local-value

# Stripe, test mode only (keys must start with sk_test_)
STRIPE_SECRET_KEY=sk_test_dummy_replace_me
STRIPE_WEBHOOK_SECRET=whsec_dummy_replace_me
STRIPE_PRICE_STARTER=price_dummy_starter
STRIPE_PRICE_TEAM=price_dummy_team

# Anthropic (server only)
ANTHROPIC_API_KEY=dummy-anthropic-key-replace-me
ANTHROPIC_MODEL=claude-haiku-4-5
# Account briefs allowed per workspace per calendar month
AI_MONTHLY_BRIEF_LIMIT=200

# Tests only: a throwaway Postgres database the test suite may drop and recreate
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tidewater_test
